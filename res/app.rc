#include <windows.h>
#include "resource.h"

IDI_APP       ICON         "app.ico"
IDR_MANIFEST  RT_MANIFEST  "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,2,0
PRODUCTVERSION 1,0,2,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Argus"
            VALUE "FileDescription",  "Argus - lightweight screenshot tool"
            VALUE "FileVersion",      "1.0.2.0"
            VALUE "InternalName",     "argus"
            VALUE "OriginalFilename", "argus.exe"
            VALUE "ProductName",      "Argus"
            VALUE "ProductVersion",   "1.0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
